# Credenciais de uma service account do Firebase (projeto Firestore). Sem
# elas, o app cai automaticamente pro modo mock em desenvolvimento/teste —
# ver src/api/infrastructure/repositories/RepositoryFactory.ts. Em produção
# são obrigatórias: sem elas, o app falha ao iniciar.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary. CLOUD_NAME é lido pelo app (PhotoRepositoryImpl resolve fotos
# reais do Firestore em URL de entrega — ver src/api/infrastructure/cloudinary).
# API_KEY/API_SECRET só são usados pelo script de migração
# (scripts/migrate-to-firestore.ts, upload assinado) — nunca pelo app Next,
# nunca chegam ao client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
